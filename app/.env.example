# Copiar a .env y llenar con los valores del dashboard de Spotify
# (https://developer.spotify.com/dashboard). El client ID es público (se usa con
# PKCE, sin client secret), pero de todas formas no se versiona por conveniencia.

# Client ID de la app registrada en el dashboard de Spotify.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# Redirect URI HTTPS registrado en el dashboard, usado solo en builds nativos
# (dev build / producción). En web se calcula solo como http://127.0.0.1:<puerto>.
# Debe apuntar a un endpoint del backend que complete el deep link de vuelta a la app
# (ver Stack_tecnico_proyecto.md, sección de arquitectura) — pendiente hasta que
# exista el backend.
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=
